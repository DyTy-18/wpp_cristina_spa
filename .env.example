# URL base de Laravel para las rutas /api/wpp/citas... (consultar/confirmar/cancelar/agendar)
CITAS_API_URL=
# Mismo texto fijo que Laravel tiene guardado como WPPCONNECT_TOKEN en su .env
WPPCONNECT_TOKEN=

# Panel de administración
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
ADMIN_USERNAME=admin
# Generar con: node -e "console.log(require('bcrypt').hashSync('tu-password', 10))"
ADMIN_PASSWORD_HASH=
WPP_ADMIN_SESSION=citas
